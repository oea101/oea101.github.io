1:[["$","h1",null,{"children":"About"}],["$","div",null,{"className":"about-layout","children":[["$","aside",null,{"className":"about-portrait","children":[["$","img",null,{"src":"/images/manny-akintayo.jpg","alt":"Manny Akintayo","width":"800","height":"800"}],["$","div",null,{"className":"about-socials","children":[["$","a",null,{"href":"https://www.linkedin.com/in/emmanuel-manny-akintayo-a80b6313/","aria-label":"Manny Akintayo on LinkedIn","title":"LinkedIn","children":["$","svg",null,{"viewBox":"0 0 24 24","width":"24","height":"24","aria-hidden":"true","fill":"currentColor","children":["$","path",null,{"d":"M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8v-4.64c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.5v5.27Z"}]}]}],["$","a",null,{"href":"https://getcbt.substack.com/","aria-label":"CoffeeBreak on Substack","title":"Substack","children":["$","svg",null,{"viewBox":"0 0 24 24","width":"24","height":"24","aria-hidden":"true","fill":"currentColor","children":["$","path",null,{"d":"M2 2h20v2H2zm0 5h20v2H2zm0 5h20v12l-10-6-10 6z"}]}]}]]}]]}],["$","div",null,{"className":"bio","children":[["$","p",null,{"children":"Hi, I’m Manny Akintayo. I’m an engineer by training, a product leader, and an entrepreneur. My work spans AI, healthcare, fintech, and consumer products. I’ve built new businesses and helped scale products used by millions of people. Today, I lead AI product and platform teams at PayPal."}],["$","p",null,{"children":"I started my career building software for banking and healthcare, working on distributed applications and enterprise search systems. At OfferUp and Meta, I worked on machine learning infrastructure for advertising, including data pipelines for ad ranking and serving that helped generate $1 billion in new revenue."}],["$","p",null,{"children":"I later co-founded Gentem Health, combining AI and financial services to simplify medical billing and help doctors get paid. We raised $20 million across several funding rounds and scaled the product and business before selling the company to a publicly traded company in 2023."}],["$","p",null,{"children":"After Gentem, I joined Menlo Ventures as an Entrepreneur in Residence, exploring new startup ideas."}],["$","p",null,{"children":["I enjoy staying close to the technology while thinking about the people and problems behind it. This site is where I share my ",["$","a",null,{"href":"/writing/","children":"writing"}],", ",["$","a",null,{"href":"/speaking/","children":"conversations"}],", and ",["$","a",null,{"href":"/prototyping/","children":"experiments"}]," in AI and product building."]}],""]}]]}]]
