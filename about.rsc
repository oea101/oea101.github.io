1:[["$","h1",null,{"children":"About"}],["$","div",null,{"className":"about-layout","children":[["$","aside",null,{"className":"about-portrait","children":[["$","img",null,{"src":"/images/manny-akintayo.jpg","alt":"Manny Akintayo","width":"800","height":"800"}],["$","a",null,{"href":"https://www.linkedin.com/in/emmanuel-manny-akintayo-a80b6313/","children":"LinkedIn"}],["$","br",null,{}],["$","a",null,{"href":"https://getcbt.substack.com/","children":"Substack"}]]}],["$","div",null,{"className":"bio","children":[["$","p",null,{"children":"Hi, I’m Manny Akintayo. I’m an engineer by training, a product leader, and an entrepreneur. My work spans AI, healthcare, fintech, and consumer products. I’ve built new businesses and helped scale products used by millions of people. Today, I lead AI product and platform teams at PayPal."}],["$","p",null,{"children":"I started my career building software for banking and healthcare, working on distributed applications and enterprise search systems. At OfferUp and Meta, I worked on machine learning infrastructure for advertising, including data pipelines for ad ranking and serving that helped generate $1 billion in new revenue."}],["$","p",null,{"children":"I later co-founded Gentem Health, combining AI and financial services to simplify medical billing and help doctors get paid. We raised $20 million across several funding rounds and scaled the product and business before selling the company to a publicly traded company in 2023."}],["$","p",null,{"children":"After Gentem, I joined Menlo Ventures as an Entrepreneur in Residence, exploring new startup ideas."}],["$","p",null,{"children":["I enjoy staying close to the technology while thinking about the people and problems behind it. This site is where I share my ",["$","a",null,{"href":"/writing/","children":"writing"}],", ",["$","a",null,{"href":"/speaking/","children":"conversations"}],", and ",["$","a",null,{"href":"/prototyping/","children":"experiments"}]," in AI and product building."]}],""]}]]}]]
